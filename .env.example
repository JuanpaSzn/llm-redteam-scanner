# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Models used by the attacker and the judge (both default to gpt-4o-mini)
REDSCAN_ATTACKER_MODEL=gpt-4o-mini
REDSCAN_JUDGE_MODEL=gpt-4o-mini

# Optional: point attacker/judge at any OpenAI-compatible server (e.g. Ollama: http://localhost:11434/v1)
# REDSCAN_LLM_BASE_URL=

# Optional: override the Gandalf API base URL
# GANDALF_API_URL=https://gandalf-api.lakera.ai/api
